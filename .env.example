# SafeCity AI Environment Configuration Example
# Copy this file to .env and insert your private credentials
# NEVER commit .env to version control

# Roboflow Hosted Inference API (Preferred Model: ambulance-4bova-a3goa/4)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=ambulance-4bova-a3goa/4

# Detection Settings
CONFIDENCE_THRESHOLD=0.50
FRAME_SKIP=2
CONFIRMATION_FRAMES=3
DROPOUT_TOLERANCE_FRAMES=20

# Routing & Simulation Defaults
DEFAULT_START_NODE=START_CCTV
DEFAULT_DESTINATION=HOSPITAL_CITY
